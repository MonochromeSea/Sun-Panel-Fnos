#!/bin/bash

LOG_FILE="${TRIM_PKGVAR}/${TRIM_APPNAME}.log"
PID_FILE="${TRIM_PKGVAR}/${TRIM_APPNAME}.pid"

APP_DIR="${TRIM_APPDEST}"
APP_DATA_DIR="${TRIM_PKGVAR}"

SERVICE_COMMAND="$APP_DIR/bin/1panel-server $APP_DATA_DIR"
SVC_BACKGROUND=y
SVC_WRITE_PID=y

# 1panel's binary reads its port, base directory and other startup params by
# grepping /usr/local/bin/1pctl (see core/utils/common/common.go LoadParams).
# Without those keys it panics on boot with:
#   panic: error `BASE_DIR` find in /usr/local/bin/1pctl
#
# KNOWN BROKEN — this app cannot currently start, and seeding 1pctl from here
# does NOT fix it. fnOS runs the install/upgrade hooks as the unprivileged app
# user (verified on fnOS 1.2.0203: CREDENTIALS.txt below is created owned by
# 1panel:1panel, and the write two lines down fails with
# "/usr/local/bin/1pctl: Permission denied"), and /usr/local/bin is root:root
# 755. `cmd/main start` is likewise unprivileged. So nothing in this package can
# create the one file the binary insists on reading.
#
# Fixing it properly requires granting the app root, i.e. `install_type = root`
# in the manifest plus `"run-as": "root"` in config/privilege (see
# nvidia-driver / surface-battery). That also relocates the app off the storage
# volume to /usr/local/apps, so it is a packaging decision, not a code fix.
# The seeding below is kept because it is correct once the hook has privileges;
# it now reports the failure instead of leaving a silently broken install.
seed_1pctl() {
    # Idempotent: only generate random secrets on first install.
    local creds="${TRIM_PKGVAR}/CREDENTIALS.txt"
    local username password entrance
    if [ -f "$creds" ]; then
        username=$(grep '^username=' "$creds" | cut -d= -f2-)
        password=$(grep '^password=' "$creds" | cut -d= -f2-)
        entrance=$(grep '^entrance=' "$creds" | cut -d= -f2-)
    else
        username="admin"
        password=$(openssl rand -hex 8 2>/dev/null || head -c 8 /dev/urandom | base64 | tr -dc 'a-zA-Z0-9' | head -c 16)
        entrance=$(openssl rand -hex 4 2>/dev/null || head -c 4 /dev/urandom | base64 | tr -dc 'a-zA-Z0-9' | head -c 8)
        mkdir -p "${TRIM_PKGVAR}"
        umask 077
        cat > "$creds" <<CREDS
# 1Panel 首次安装生成的默认凭证。登录后请在面板设置中修改并删除本文件。
username=$username
password=$password
entrance=$entrance
url=http://<NAS-IP>:${TRIM_SERVICE_PORT:-10086}/$entrance
CREDS
    fi

    if ! mkdir -p /usr/local/bin 2>/dev/null || ! : > /usr/local/bin/1pctl 2>/dev/null; then
        echo "ERROR: cannot write /usr/local/bin/1pctl (running as $(id -un), needs root)." >&2
        echo "       1panel will panic on start with: error \`BASE_DIR\` find in /usr/local/bin/1pctl" >&2
        echo "       This app needs install_type=root + run-as root to work." >&2
        return 1
    fi
    cat > /usr/local/bin/1pctl <<EOF
#!/bin/bash
# Stub config-source for 1panel. The real 1pctl is the upstream management CLI;
# the daemon only greps these KEY=VALUE lines at first boot, then migrates
# values into its SQLite DB at ${TRIM_PKGVAR}/db/1Panel.db.
# Managed by fnos-apps; change settings via the 1panel UI — do not edit here.
BASE_DIR=${TRIM_PKGVAR}
ORIGINAL_PORT=${TRIM_SERVICE_PORT:-10086}
ORIGINAL_VERSION=${TRIM_APPVERSION:-1.10.34-lts}
ORIGINAL_ENTRANCE=$entrance
ORIGINAL_USERNAME=$username
ORIGINAL_PASSWORD=$password
LANGUAGE=zh
PANEL_EDITION=cn
CHANGE_USER_INFO=false
EOF
    chmod 755 /usr/local/bin/1pctl 2>/dev/null || true
}

service_preinst() {
    seed_1pctl
}

# NOTE: no service_postupgrade hook — the upgrade hooks are unprivileged too,
# so re-seeding there only produces "Permission denied" noise in the app log.

service_preuninst() {
    # Best-effort cleanup of the 1pctl stub (unprivileged, so usually a no-op).
    rm -f /usr/local/bin/1pctl 2>/dev/null || true

    # 使用 -x 精确匹配进程名，避免误杀 appcenter-cli 等包含 "1panel" 参数的进程
    pkill -x "1panel" 2>/dev/null || true
    sleep 1
    pkill -9 -x "1panel" 2>/dev/null || true
}

service_poststop() {
    pkill -x "1panel" 2>/dev/null || true
    sleep 1
    pkill -9 -x "1panel" 2>/dev/null || true
}
