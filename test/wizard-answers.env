# Per-app wizard answers for the VM test harness.
# Maps an app slug to a JSON array of {"key":...,"value":...} submitted as the
# install customParameters. Values here are TEST values — never real secrets.
#
# Apps not listed fall back to a generic fill (see wizard_answers_for in
# lib.sh): every required text/password field gets "fnostest-value" and every
# field with an initValue keeps it.
#
# Format (one entry per line):
#   WIZARD_ANSWERS_<slug>='[{"key":"wizard_x","value":"..."}]'

WIZARD_ANSWERS_sakurafrp='[{"key":"wizard_natfrp_token","value":"fnostest-token-0000"},{"key":"wizard_natfrp_remote","value":"fnostest-pass-0000"}]'
